# Настройки публичного размещения. Скопируйте в .env.production (в git не попадает) и заполните.
# При PUBLIC_DEPLOYMENT=true сервер НЕ запустится с демо-паролями, коротким паролем или пустым секретом.

# Секрет подписи cookie: случайная строка ≥ 32 символов, например: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Первые учётные записи (создаются только при первом запуске на пустой БД). Пароли — уникальные, ≥ 12 символов.
# Для жюри лучше создать отдельного оператора в панели администратора и удалить/отключить его после защиты.
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
