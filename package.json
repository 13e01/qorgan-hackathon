{
  "name": "qorgan",
  "version": "0.1.0",
  "private": true,
  "description": "QORGAN — учебная платформа мониторинга и раннего предупреждения паводков (р. Есиль, СКО)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "npm run start -w @qorgan/server",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:reset": "npm run db:reset -w @qorgan/server",
    "db:backup": "npm run db:backup -w @qorgan/server",
    "db:fixture": "npm run db:fixture -w @qorgan/server",
    "demo:wave": "npm run demo:wave -w @qorgan/server --",
    "build": "npm run build -w @qorgan/web",
    "dev:server": "npm run dev -w @qorgan/server",
    "mqtt:broker": "npm run mqtt:broker -w @qorgan/server",
    "ml:setup": "py -m venv ml/.venv && ml\\.venv\\Scripts\\python -m pip install -r ml/requirements.txt",
    "ml:dataset": "tsx ml/dataset/export.ts --episodes 500 && tsx ml/dataset/export.ts --official",
    "ml:train": "cd ml && .venv\\Scripts\\python -m sentinel.train",
    "ml:test": "ml\\.venv\\Scripts\\python -m unittest discover -s ml/tests -t ml",
    "telegram:mock": "node scripts/telegram-mock.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
