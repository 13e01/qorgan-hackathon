# Настройки QORGAN. Скопируйте в .env командой `npm run setup` (секрет сессий сгенерируется сам).
# Файл .env в git не попадает.

PORT=3000
HOST=127.0.0.1
DB_PATH=data/qorgan.db
BACKUP_DIR=data/backups

# Секрет подписи cookie сессий (не короче 32 символов). `npm run setup` заменит значение на случайное.
SESSION_SECRET=replace-me
SESSION_TTL_HOURS=12

# Демо-учётные записи, создаются при первом запуске / `npm run db:reset`.
# Это учебные пароли только для локального прототипа — не используйте их где-либо ещё.
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=qorgan-operator-demo
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=qorgan-admin-demo

# MQTT (Python-датчик). Локальный брокер слушает только 127.0.0.1. `npm run setup` подставит случайные пароли.
MQTT_PORT=1883
MQTT_SERVICE_USERNAME=qorgan-server
MQTT_SERVICE_PASSWORD=replace-me
# Демо-устройство: создаётся в БД при запуске сервера; пароль датчика = SENSOR_TOKEN (в git не попадает).
SENSOR_DEVICE_ID=PY-SENSOR-01
SENSOR_STATION=QRG-03
SENSOR_TOKEN=replace-me

# QORGAN Sentinel — учебная ML-модель (параллельная оценка). Файл в git: ml/models/sentinel-model.json.
# ML_ENABLED=false — выключить; нет файла — QORGAN работает с основной оценкой риска.
ML_ENABLED=true
ML_MODEL_PATH=ml/models/sentinel-model.json

# Telegram-бот (docs/SENTINEL_TELEGRAM.md). Пусто — бот выключен, QORGAN работает как обычно.
# Токен от @BotFather вписывайте ТОЛЬКО в .env (он в .gitignore), не в этот файл.
TELEGRAM_BOT_TOKEN=
# Необязательно: только эти chat_id могут привязаться и получать сообщения (через запятую).
TELEGRAM_ALLOWED_CHAT_IDS=
# Адрес QORGAN для ссылки «Открыть QORGAN» в сообщениях.
PUBLIC_URL=http://localhost:3000
